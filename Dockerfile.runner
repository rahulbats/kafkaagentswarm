# Dockerfile.runner
ARG BASE_IMAGE=golang:1.26
FROM ${BASE_IMAGE} AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download

# Copy source files
COPY . .

# Build the runner binary from the cmd/runner package (split across several
# files - main.go, agent.go, envelope.go, handler.go, join.go, mcp.go)
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o agent-runner ./cmd/runner

# Minimal runtime image
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/agent-runner .
USER 65532:65532

ENTRYPOINT ["/agent-runner"]
